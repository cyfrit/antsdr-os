# SPDX-License-Identifier: MIT
#### Vivado ML Standard Install Configuration ####
Edition=Vivado ML Standard

Product=Vivado

# Replaced by install-vivado.sh. Keep the toolchain inside the expanded CI
# workspace so the installer and FPGA build share the same filesystem.
Destination=@DESTINATION@

# E310 requires the Zynq-7000 device database and the embedded command-line
# tools that provide XSCT and bootgen.
Modules=Zynq-7000:1,Vitis Embedded Development:1

InstallOptions=Acquire or Manage a License Key:0,Enable WebTalk for Vivado to send usage statistics to Xilinx (Always enabled for WebPACK license):0
CreateProgramGroupShortcuts=0
CreateShortcutsForAllUsers=0
CreateDesktopShortcuts=0
CreateFileAssociation=0
EnableDiskUsageOptimization=1
