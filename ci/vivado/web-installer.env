# Pinned source and verification material for the Vivado Web Installer.

VIVADO_VERSION=2023.2

# R2 source coordinates and credentials are GitHub Secrets. No R2 URL or
# object path belongs in the repository.
R2_S3_API_URL_ENV=R2_S3_API_URL
R2_BUCKET_ENV=R2_BUCKET
R2_INSTALLER_KEY_ENV=R2_INSTALLER_KEY
R2_ACCESS_KEY_ID_ENV=R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY_ENV=R2_SECRET_ACCESS_KEY
AMD_USERNAME_ENV=AMD_USERNAME
AMD_PASSWORD_ENV=AMD_PASSWORD

# AMD/Xilinx publishes this detached signature for the exact installer above.
VIVADO_SIGNING_KEY_URL=https://www.xilinx.com/support/download/2018-2-1/xilinx-master-signing-key.asc
VIVADO_SIGNING_KEY_SHA256=6795F14A5299319A3A5B08DD44D3C9423D48EEB64FB47FBF8FB5D639D9E8A26B
VIVADO_SIGNING_PRIMARY_FINGERPRINT=4D27DDF2A08955CE241B4304FD3DD2C355D2B701
VIVADO_SIGNING_SUBKEY_FINGERPRINT=E5F24BD454F2C46DB4D669A55DB253CE971AD24F
VIVADO_INSTALLER_SIGNATURE_
