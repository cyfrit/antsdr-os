{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cyfrit/antsdr-firmware/boards/schema/board-v1.schema.json",
  "title": "ANTSDR board contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "vendor",
    "aliases",
    "status",
    "support",
    "upstream",
    "toolchain",
    "build",
    "hardware",
    "compatibility",
    "sources"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "vendor": { "type": "string", "minLength": 1 },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "status": {
      "enum": ["scaffold", "development", "build-validated", "hardware-validated"]
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_revisions", "firmware_validation", "limitations"],
      "properties": {
        "reference_revisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["revision", "evidence", "sources"],
            "properties": {
              "revision": { "type": "string" },
              "evidence": { "enum": ["vendor-reference", "device-observed", "firmware-tested"] },
              "sources": { "$ref": "#/$defs/sourceRefs" }
            }
          }
        },
        "firmware_validation": {
          "enum": ["not-built", "static-only", "built", "booted", "hardware-tested"]
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plutosdr_fw", "components"],
      "properties": {
        "plutosdr_fw": { "$ref": "#/$defs/upstreamPin" },
        "components": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/upstreamPin" },
          "required": ["hdl", "linux", "u_boot", "buildroot"]
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vivado", "fsbl", "linux"],
      "properties": {
        "vivado": { "$ref": "#/$defs/tool" },
        "fsbl": { "$ref": "#/$defs/tool" },
        "linux": { "$ref": "#/$defs/tool" }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
        "required": ["hdl_project", "linux_dtbs", "linux_defconfig", "u_boot_defconfig", "buildroot_defconfig", "firmware", "profile_selection"],
        "properties": {
          "hdl_project": { "type": "string" },
          "linux_dtbs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+\\.dtb$" }
          },
          "linux_defconfig": { "type": "string" },
          "u_boot_defconfig": { "type": "string" },
          "buildroot_defconfig": { "type": "string" },
          "firmware": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fit_image", "kernel_image", "rootfs_image", "boot_image", "qspi_partition"],
            "properties": {
              "fit_image": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+\\.itb$" },
              "kernel_image": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
              "rootfs_image": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
              "boot_image": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
              "qspi_partition": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" }
            }
          },
          "profile_selection": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dimensions"],
            "properties": {
              "dimensions": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
                }
              }
            }
          }
        }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["soc", "ddr", "clocks", "gpios", "pl_io", "rf", "datapath", "boot"],
      "properties": {
        "soc": { "$ref": "#/$defs/sourcedObject" },
        "ddr": { "$ref": "#/$defs/sourcedObject" },
        "clocks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourcedObject" }
        },
        "gpios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              { "$ref": "#/$defs/sourcedObject" },
              {
                "type": "object",
                "required": ["name", "controller", "line", "direction", "active"]
              }
            ]
          }
        },
        "pl_io": {
          "type": "object",
          "additionalProperties": false,
          "required": ["signals", "sources"],
          "properties": {
            "signals": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["port", "package_pin", "iostandard", "direction", "pull"],
                "properties": {
                  "port": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
                  "index": { "type": "integer", "minimum": 0 },
                  "package_pin": { "type": "string", "pattern": "^[A-Z]+[0-9]+$" },
                  "iostandard": { "enum": ["LVCMOS18", "LVCMOS33"] },
                  "direction": { "enum": ["input", "output", "inout"] },
                  "pull": { "enum": ["none", "up", "down"] }
                }
              }
            },
            "sources": { "$ref": "#/$defs/sourceRefs" }
          }
        },
        "rf": { "$ref": "#/$defs/sourcedObject" },
        "datapath": { "$ref": "#/$defs/sourcedObject" },
        "boot": { "$ref": "#/$defs/sourcedObject" }
      }
    },
    "compatibility": {
      "type": "object",
      "required": ["hardware", "software"],
      "properties": {
        "hardware": { "type": "array", "minItems": 1 },
        "software": { "type": "array", "minItems": 1 }
      }
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "repository", "commit", "path"],
        "properties": {
          "kind": { "enum": ["upstream", "vendor-patch", "vendor-patch-result", "device-evidence"] },
          "repository": { "type": "string", "format": "uri" },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "path": { "type": "string", "minLength": 1 },
          "target": { "type": "string" },
          "lines": { "type": "string", "pattern": "^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$" },
          "notes": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
      "uniqueItems": true
    },
    "upstreamPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "status", "sources"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "status": { "enum": ["required", "deferred", "available"] },
        "sources": { "$ref": "#/$defs/sourceRefs" }
      }
    },
    "sourcedObject": {
      "type": "object",
      "required": ["sources"],
      "properties": {
        "sources": { "$ref": "#/$defs/sourceRefs" }
      }
    }
  }
}
