From: Cyfrit <i@cli.tf>
Subject: [PATCH] ARM: dts: add ANTSDR E310 bootloader integration
SPDX-License-Identifier: GPL-2.0-or-later

Keep the E310 implementation in the downstream overlay and add only the
U-Boot device-tree build hook upstream.

diff --git a/arch/arm/dts/Makefile b/arch/arm/dts/Makefile
index 7b19efc9b8..e651d9d922 100644
--- a/arch/arm/dts/Makefile
+++ b/arch/arm/dts/Makefile
@@ -101,7 +101,8 @@ dtb-$(CONFIG_ARCH_ZYNQ) += zynq-zc702.dtb \
 	zynq-zc770-xm010.dtb \
 	zynq-zc770-xm011.dtb \
 	zynq-zc770-xm012.dtb \
-	zynq-zc770-xm013.dtb
+	zynq-zc770-xm013.dtb \
+	zynq-antsdr-e310.dtb
 dtb-$(CONFIG_ARCH_ZYNQMP) += \
 	zynqmp-ep108.dtb			\
 	zynqmp-zcu100.dtb			\
diff --git a/cmd/Kconfig b/cmd/Kconfig
--- a/cmd/Kconfig
+++ b/cmd/Kconfig
@@ -264,6 +264,20 @@ config CMD_ENV_EXISTS
 	  Check if a variable is defined in the environment for use in
 	  shell scripting.
 
+config CMD_ANTSDR_UENV
+	bool "ANTSDR restricted uEnv import"
+	depends on CMD_IMPORTENV
+	help
+	  Import only the board-approved RF profile selectors from a
+	  text-formatted uEnv file.
+
+config ANTSDR_UENV_COMPAT
+	bool "Allow unrestricted ANTSDR uEnv compatibility mode"
+	depends on CMD_ANTSDR_UENV
+	help
+	  Use the conventional env import and uenvcmd ABI. Disable this for
+	  a locked build that imports only rf_model and rf_topology.
+
 endmenu
 
 menu "Memory commands"
diff --git a/cmd/Makefile b/cmd/Makefile
--- a/cmd/Makefile
+++ b/cmd/Makefile
@@ -151,4 +151,5 @@ obj-$(CONFIG_CMD_ZYNQ_RSA) += zynq_rsa.o
 
 obj-$(CONFIG_CMD_DFU) += dfu.o
+obj-$(CONFIG_CMD_ANTSDR_UENV) += antsdr_uenv.o
 obj-$(CONFIG_CMD_GPT) += gpt.o
 obj-$(CONFIG_CMD_ETHSW) += ethsw.o
