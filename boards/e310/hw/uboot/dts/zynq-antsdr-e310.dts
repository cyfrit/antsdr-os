/*
 * ANTSDR E310 Rev.C U-Boot device tree.
 *
 * Copyright (C) 2026 Cyfrit <i@cli.tf>
 */

/dts-v1/;
#include "zynq-7000.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include "antsdr-os-release-key.dtsi"

/ {
	model = "ANTSDR E310 Rev.C";
	compatible = "microphase,antsdr-e310-revc", "microphase,antsdr-e310",
		     "xlnx,zynq-7000";

	aliases {
		ethernet0 = &gem0;
		mmc0 = &sdhci0;
		serial0 = &uart1;
		spi0 = &qspi;
	};

	memory {
		device_type = "memory";
		reg = <0x0 0x40000000>;
	};

	chosen {
		bootargs = "earlyprintk";
		linux,stdout-path = &uart1;
		stdout-path = "serial0:115200n8";
	};

	usb_phy0: phy0 {
		compatible = "usb-nop-xceiv";
		#phy-cells = <0>;
	};
};

&qspi {
	u-boot,dm-pre-reloc;
	status = "okay";
	is-dual = <0>;
	num-cs = <1>;

	flash@0 {
		compatible = "jedec,spi-nor", "spi-flash";
		reg = <0>;
		spi-max-frequency = <50000000>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <4>;
		#address-cells = <1>;
		#size-cells = <1>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "qspi-fsbl-uboot";
				reg = <0x000000 0x400000>;
			};

			partition@400000 {
				label = "qspi-uboot-env";
				reg = <0x400000 0x020000>;
			};

			partition@420000 {
				label = "qspi-nvmfs";
				reg = <0x420000 0x0e0000>;
			};

			partition@500000 {
				label = "qspi-linux";
				reg = <0x500000 0x1b00000>;
			};
		};
	};
};

&sdhci0 {
	u-boot,dm-pre-reloc;
	status = "okay";
};

&uart1 {
	u-boot,dm-pre-reloc;
	status = "okay";
};

&usb0 {
	status = "okay";
	dr_mode = "host";
	usb-phy = <&usb_phy0>;
};

&gem0 {
	status = "okay";
	phy-mode = "rgmii-id";
	phy-handle = <&ethernet_phy0>;

	ethernet_phy0: ethernet-phy@0 {
		reg = <0>;
		reset-gpios = <&gpio0 46 GPIO_ACTIVE_LOW>;
	};
};
