#!/bin/sh
# SPDX-License-Identifier: MIT
# Synchronize the host-visible FAT configuration image at USB eject boundaries.

set -eu

. /usr/lib/antsdr/runtime.sh

IMAGE=/opt/antsdr/config.vfat
MOUNT_DIR=/run/antsdr/config-volume
STATE_FILE=/run/antsdr/config-volume.sha256
UPDATE_STATE_FILE=/mnt/antsdr-persist/etc/firmware-update.sha256
PID_FILE=/run/antsdr/config-volume.pid
LUN=/sys/kernel/config/usb_gadget/antsdr/functions/mass_storage.0/lun.0/file
CONFIG=/usr/sbin/antsdr-config

mount_volume() {
    mkdir -p "$MOUNT_DIR"
    antsdr_is_mounted "$MOUNT_DIR" || mount -t vfat -o loop,rw "$IMAGE" "$MOUNT_DIR"
}

unmount_volume() {
    antsdr_is_mounted "$MOUNT_DIR" && umount "$MOUNT_DIR"
}

attach_volume() {
    printf '%s\n' "$IMAGE" > "$LUN"
}

prepare_volume() {
    printf '\n' > "$LUN" 2>/dev/null || true
    result=0
    if mount_volume; then
        $CONFIG export "$MOUNT_DIR/config.txt" || result=$?
        cp /www/index.html "$MOUNT_DIR/index.html" || result=$?
        if [ "$result" -eq 0 ]; then
            printf '%s\n' "$(antsdr_sha256_file "$MOUNT_DIR/config.txt")" > "$STATE_FILE" || result=$?
        fi
        sync
        unmount_volume || result=$?
    else
        result=$?
    fi
    attach_volume || result=$?
    return "$result"
}

process_eject() {
    sleep 1
    result=0
    if mount_volume; then
        if current=$(antsdr_sha256_file "$MOUNT_DIR/config.txt"); then
            previous=$(cat "$STATE_FILE" 2>/dev/null || true)
            if [ "$current" != "$previous" ]; then
                if $CONFIG import "$MOUNT_DIR/config.txt"; then
                    diagnostic_failed=0
                    if [ "$($CONFIG action "$MOUNT_DIR/config.txt" diagnostic_report)" = 1 ]; then
                        if /usr/sbin/antsdr-diagnostic > "$MOUNT_DIR/diagnostic_report.txt"; then
                            printf 'Configuration saved. Diagnostic report generated. Reboot to apply settings.\r\n' > "$MOUNT_DIR/CONFIG_APPLIED.TXT"
                        else
                            diagnostic_failed=1
                            printf 'Configuration saved, but diagnostic report generation failed.\r\n' > "$MOUNT_DIR/CONFIG_ERROR.TXT"
                        fi
                    else
                        printf 'Configuration saved. Reboot to apply it.\r\n' > "$MOUNT_DIR/CONFIG_APPLIED.TXT"
                    fi
                    $CONFIG export "$MOUNT_DIR/config.txt"
                    current=$(antsdr_sha256_file "$MOUNT_DIR/config.txt")
                    [ "$diagnostic_failed" = 0 ] && rm -f "$MOUNT_DIR/CONFIG_ERROR.TXT"
                else
                    printf 'Configuration was not saved: an accepted setting is invalid.\r\n' > "$MOUNT_DIR/CONFIG_ERROR.TXT"
                fi
            fi
            printf '%s\n' "$current" > "$STATE_FILE"
        else
            result=$?
        fi
        if [ -f "$MOUNT_DIR/firmware-update.conf" ]; then
            update_digest=$(antsdr_sha256_file "$MOUNT_DIR/firmware-update.conf")
            previous_update=$(cat "$UPDATE_STATE_FILE" 2>/dev/null || true)
            if [ "$update_digest" != "$previous_update" ]; then
                if /usr/sbin/antsdr-update "$MOUNT_DIR/firmware-update.conf" "$MOUNT_DIR" > "$MOUNT_DIR/FIRMWARE_UPDATE.TXT"; then
                    mkdir -p "$(dirname "$UPDATE_STATE_FILE")" 2>/dev/null || true
                    printf '%s\n' "$update_digest" > "$UPDATE_STATE_FILE" 2>/dev/null || true
                    rm -f "$MOUNT_DIR/FIRMWARE_UPDATE.ERROR"
                    rm -f "$MOUNT_DIR/firmware-update.conf"
                else
                    rm -f "$MOUNT_DIR/FIRMWARE_UPDATE.TXT"
                    printf 'Firmware update failed. See the serial console.\r\n' > "$MOUNT_DIR/FIRMWARE_UPDATE.ERROR"
                    result=1
                fi
            fi
        fi
        sync
        unmount_volume || result=$?
    else
        result=$?
    fi
    attach_volume || result=$?
    return "$result"
}

watch() {
    while :; do
        if [ ! -s "$LUN" ]; then
            process_eject || logger -t antsdr-config-volume "unable to process USB configuration volume"
        fi
        sleep 1
    done
}

start() {
    mkdir -p /run/antsdr
    [ -w "$LUN" ] || {
        echo "USB mass-storage gadget is unavailable" >&2
        return 1
    }
    prepare_volume
    start-stop-daemon -S -b -q -o -m -p "$PID_FILE" -x "$0" -- watch
}

stop() {
    start-stop-daemon -K -q -p "$PID_FILE" 2>/dev/null || true
    printf '\n' > "$LUN" 2>/dev/null || true
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    watch) watch ;;
    *)
        echo "Usage: $0 {start|stop|restart}" >&2
        exit 2
        ;;
esac
