#!/bin/sh
# SPDX-License-Identifier: MIT
# Apply the optional USB suspend workaround without owning gadget lifecycle.

set -eu

. /usr/lib/antsdr/runtime.sh

udc=${1:?UDC name is required}
iio_dir=$(antsdr_find_iio_device ad9361-phy) || exit 0
previous=$(cat "$iio_dir/ensm_mode")

while :; do
    state=$(cat "/sys/class/udc/$udc/state" 2>/dev/null || echo unknown)
    case "$state" in
        suspended)
            previous=$(cat "$iio_dir/ensm_mode")
            printf 'sleep\n' > "$iio_dir/ensm_mode"
            ;;
        *)
            current=$(cat "$iio_dir/ensm_mode")
            if [ "$current" != "$previous" ]; then
                printf '%s\n' "$previous" > "$iio_dir/ensm_mode"
            fi
            ;;
    esac
    sleep 1
done
