#!/bin/sh
# SPDX-License-Identifier: MIT
# Persist only explicitly supported credentials and host keys to JFFS2.

set -eu

. /usr/lib/antsdr/runtime.sh

mount_persist() {
    mkdir -p "$PERSIST_MOUNT_DIR"
    if ! antsdr_is_mounted "$PERSIST_MOUNT_DIR"; then
        mount -t jffs2 -o rw,noatime "$PERSIST_MTD_BLOCK_DEVICE" "$PERSIST_MOUNT_DIR"
    fi
}

save_credentials() {
    mount_persist
    install -D -m 0644 /etc/passwd "$PERSIST_MOUNT_DIR/etc/passwd"
    install -D -m 0600 /etc/shadow "$PERSIST_MOUNT_DIR/etc/shadow"
    install -D -m 0644 /etc/group "$PERSIST_MOUNT_DIR/etc/group"
    (
        cd "$PERSIST_MOUNT_DIR/etc"
        sha256sum passwd shadow group > credentials.sha256
    )
}

save_keys() {
    mount_persist
    mkdir -p "$PERSIST_MOUNT_DIR/etc/dropbear" "$PERSIST_MOUNT_DIR/root/.ssh"
    if ls /etc/dropbear/dropbear_*_host_key >/dev/null 2>&1; then
        install -m 0600 /etc/dropbear/dropbear_*_host_key "$PERSIST_MOUNT_DIR/etc/dropbear/"
        (
            cd "$PERSIST_MOUNT_DIR/etc/dropbear"
            sha256sum dropbear_*_host_key > keys.sha256
        )
    fi
    if [ -f /root/.ssh/authorized_keys ]; then
        install -m 0600 /root/.ssh/authorized_keys "$PERSIST_MOUNT_DIR/root/.ssh/authorized_keys"
        (
            cd "$PERSIST_MOUNT_DIR/root/.ssh"
            sha256sum authorized_keys > authorized_keys.sha256
        )
    fi
}

case "${1:-}" in
    init)
        [ "${2:-}" = "--confirm" ] || {
            echo "refusing to erase persistent storage without --confirm" >&2
            exit 2
        }
        if ! reason=$(antsdr_persist_layout_status); then
            echo "refusing to erase persistent storage: $reason" >&2
            exit 1
        fi
        if antsdr_is_mounted "$PERSIST_MOUNT_DIR"; then
            umount "$PERSIST_MOUNT_DIR"
        fi
        flash_erase -j "$PERSIST_MTD_DEVICE" 0 0
        mkdir -p "$PERSIST_MOUNT_DIR"
        mount_persist
        ;;
    credentials)
        save_credentials
        ;;
    keys)
        save_keys
        ;;
    all)
        save_credentials
        save_keys
        ;;
    *)
        echo "Usage: $0 {init --confirm|credentials|keys|all}" >&2
        exit 2
        ;;
esac

sync
